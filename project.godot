; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="star_fox_project"
run/main_scene="res://ui/title_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

SceneFader="*res://ui/scene_fader.gd"
Settings="*res://settings/settings.gd"
Music="*res://audio/music.gd"
DevConsole="*res://ui/dev_console.gd"

[display]

window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://ui/fonts/ShareTechMono-Regular.ttf"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"

[shader_globals]

toon_softness={
"type": "float",
"value": 1.0
}
toon_shadow_tint={
"type": "color",
"value": Color(0.62, 0.72, 1, 1)
}
toon_back_rim={
"type": "float",
"value": 0.3
}
